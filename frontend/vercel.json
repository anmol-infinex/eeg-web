{
  "rewrites": [{ "source": "/(.*)", "destination": "/" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "serial=(self), microphone=(), camera=(), geolocation=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
